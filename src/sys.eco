    function eco_bt_world_reserve as cWorldReserve(ptr<eco_bt_world> $world, int32 $count) : void;
    function eco_bt_world_refresh as cWorldRefresh(ptr<eco_bt_world> $world, ptr<eco_bt_body> $body) : void;
    function eco_bt_world_get_solver as cWorldSolver(ptr<eco_bt_world> $world, ptr<RawSolver> $out) : void;
    function eco_bt_world_set_solver as cWorldSetSolver(ptr<eco_bt_world> $world, ptr<const RawSolver> $settings) : void;
    function eco_bt_world_clear_forces as cWorldClearForces(ptr<eco_bt_world> $world) : void;
    function eco_bt_world_set_update_all_aabbs as cWorldSetUpdateAllAabbs(ptr<eco_bt_world> $world, uint32 $on) : void;
    function eco_bt_world_set_air_density as cWorldSetAirDensity(ptr<eco_bt_world> $world, float32 $density) : void;

    function eco_bt_world_add_body as cWorldAddBody(ptr<eco_bt_world> $world, ptr<eco_bt_body> $body) : void;
