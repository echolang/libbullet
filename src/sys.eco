/**
 * C symbols this module is built out of, in one place.
 *
 * A C symbol may only be declared once per module. Everything here is the
 * eco_bt_* shim in c/, because Bullet itself is C++ and has no symbol Echo
 * can call. internal: other files in this module call these, a consumer
 * does not.
 */

namespace bt;

extern {
    struct eco_bt_world;
    struct eco_bt_shape;
    struct eco_bt_body;
    struct eco_bt_constraint;
    struct eco_bt_ghost;
    struct eco_bt_character;
    struct eco_bt_vehicle;
    struct eco_bt_soft;

    function eco_bt_version as cVersion() : int32;
    function eco_bt_set_sleep_seconds as cSetSleepSeconds(float32 $seconds) : void;
    function eco_bt_sleep_seconds as cSleepSeconds() : float32;
    function eco_bt_max_threads as cMaxThreads() : int32;
    function eco_bt_shutdown as cShutdown() : void;

    // world

    function eco_bt_world_create as cWorldCreate(ptr<const Vec3> $gravity, int32 $solver) : ptr<eco_bt_world>;
    function eco_bt_world_create_parallel as cWorldCreateParallel(ptr<const Vec3> $gravity, int32 $threads) : ptr<eco_bt_world>;
    function eco_bt_world_destroy as cWorldDestroy(ptr<eco_bt_world> $world) : void;
    function eco_bt_world_set_gravity as cWorldSetGravity(ptr<eco_bt_world> $world, ptr<const Vec3> $gravity) : void;
